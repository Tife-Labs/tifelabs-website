/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# Next.js & Build Outputs
# ==========================================
/.next/
/out/
/build
/dist
.turbo

# ==========================================
# Environment Variables (Strict Block)
# ==========================================
.env*
!.env.example
!.env.template

# ==========================================
# Testing & Coverage
# ==========================================
/coverage

# ==========================================
